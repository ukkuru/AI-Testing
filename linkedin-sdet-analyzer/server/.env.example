PORT=8787
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=8388608
MIN_RECOMMENDED_WIDTH=1000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Auth (required — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Set to true once served over HTTPS in production (cookie requires a secure context then)
COOKIE_SECURE=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
