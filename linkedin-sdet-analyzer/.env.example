# Copy to .env (repo root) for the Docker deployment — this is separate
# from server/.env.example, which is only used for local dev.

PORT=8787
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Same-origin in production (Nginx serves this one container for the
# whole domain), so this mainly matters if you ever call the API from
# a different origin.
CLIENT_ORIGIN=https://sdet.qpulse.sbs

MAX_UPLOAD_BYTES=8388608
MIN_RECOMMENDED_WIDTH=1000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# true because this is served over HTTPS via Nginx + Certbot
COOKIE_SECURE=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
